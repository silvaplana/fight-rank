# Configuration Caddy INTERNE (pas de TLS, pas de domaine ici) : ce
# conteneur n'est jamais exposé directement à Internet. C'est le Caddy
# "gateway" partagé (voir ~/gateway sur le VPS) qui possède le domaine
# silvaplana.cloud, le certificat HTTPS, et qui route /fight-rank/* vers
# ce conteneur en retirant le préfixe avant de le transmettre ici. Ce
# Caddyfile voit donc les requêtes comme si l'app était servie à la racine.
:80 {
	root * /srv
	encode gzip zstd

	# Le backend FastAPI définit déjà ses routes sous /api/... et sert les
	# vidéos sous /media/... (voir backend/app/main.py) : pas besoin de
	# retirer de préfixe ici, on transmet tel quel.
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /media/* {
		reverse_proxy backend:8000
	}

	# Assets Vite (JS/CSS) : le nom de fichier contient un hash du contenu,
	# donc un cache long et "immutable" est sans risque.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Sert l'app React. "try_files" fait retomber toute route inconnue sur
	# index.html : nécessaire pour une SPA (routage côté client).
	#
	# index.html ne doit JAMAIS être mis en cache par le navigateur : sans
	# ça, après un déploiement, un navigateur peut continuer à servir un
	# ancien index.html référençant d'anciens noms de fichiers assets.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
